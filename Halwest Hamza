<!DOCTYPE html>
<html lang="ku">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>گەلەری وێنە</title>

  <style>
    * {
      box-sizing: border-box;
    }

    body {
      margin: 0;
      font-family: Arial, sans-serif;
      background: #f4f4f4;
      direction: rtl;
    }

    header {
      background: #111;
      color: white;
      padding: 25px;
      text-align: center;
    }

    header h1 {
      margin: 0 0 15px;
    }

    #upload {
      display: none;
    }

    .upload-btn {
      display: inline-block;
      background: #fff;
      color: #111;
      padding: 12px 22px;
      border-radius: 10px;
      cursor: pointer;
      font-weight: bold;
    }

    .gallery {
      padding: 25px;
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
      gap: 18px;
    }

    .gallery img {
      width: 100%;
      height: 220px;
      object-fit: cover;
      border-radius: 15px;
      box-shadow: 0 4px 12px #0002;
    }

    .empty {
      text-align: center;
      color: #777;
      padding: 60px 20px;
    }
  </style>
</head>

<body>

  <header>
    <h1>🖼️ گەلەری وێنە</h1>
    <p>وێنەکانت زیاد بکە</p>

    <label class="upload-btn" for="upload">
      ➕ زیادکردنی وێنە
    </label>

    <input id="upload" type="file" accept="image/*" multiple>
  </header>

  <div id="gallery" class="gallery">
    <div class="empty">هێشتا هیچ وێنەیەکت زیاد نەکردووە 📷</div>
